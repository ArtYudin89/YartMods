// Настройки (меняются в бортовых настройках мостика ExpPilotBridge; без мостика — эти значения).
localVar("sWeapon", "int", "0");      // 0 — пока что-то на тросе, все орудия молчат; 1 — каждый груз занимает оружейный слот
localVar("sMassMult", "int", "10");   // предел общей массы грузов = мощность захвата × это число; 0 — без предела
localVar("sJump", "int", "0");        // прыжок и чёрная дыра: 0 — трос рвётся; 1 — груз летит с игроком; 2 — прыгать нельзя
localVar("sNpc", "int", "0");         // 0 — NPC груз не трогают; 1 — груз как обычный предмет
localVar("sDamage", "int", "20");     // трос рвётся, если корпус за ход теряет столько процентов; 0 — никогда

// Состояние буксира.
localVar("vOff", "int", "0");         // 1 — луч выключен в бортовых настройках (пауза; мод с сейва НЕ снят: скрипт остаётся)
localVar("vList", "str", "");         // Id грузов через запятую, по порядку цепочки
localVar("vNames", "str", "");        // имена грузов через «|» — для сообщений, когда предмета уже нет
localVar("vCount", "int", "0");       // сколько грузов на тросе
localVar("vStar", "dword", "0");      // система, где идёт буксировка
localVar("vMass", "int", "0");        // наша доля бонуса массы корабля, проценты
localVar("vJump", "int", "0");        // наш штраф к дальности прыжка, парсеки
localVar("vSlots", "int", "0");       // сколько оружейных слотов мы закрыли
localVar("vTakenOff", "str", "");     // снятые нами пушки: "Id:слот,Id:слот"
localVar("vNoJump", "int", "0");      // 1 — запрет прыжков поставили мы
localVar("vBlock", "int", "0");       // 1 — блокировку орудий держим мы
localVar("vDmgStart", "int", "-1");   // повреждение корпуса в начале хода, проценты
localVar("vHint", "int", "0");        // подсказка о клавише уже показана
