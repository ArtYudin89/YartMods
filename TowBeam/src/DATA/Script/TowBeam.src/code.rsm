// Логика буксировочного луча.
//
// Как это работает (проверено по исходникам движка, см. память project_sr_tow_beam):
// - груз — сам предмет в космосе; каждый ход на шаге 1 (путь игрока уже рассчитан) его снимают
//   из системы (GetItemFromStar) и пускают лететь к точке за кормой (DropItemInSystem с конечной
//   точкой) — движок сам ведёт и рисует его до конца хода;
// - замедление — через массу корабля (bonMass): груз весит, как будто лежит в трюме;
// - оружие — эффект блокировки орудий (ShipStatusEffect, тип 3) или закрытые слоты (bonSlotWeapon);
// - защита от NPC — предмет в именованном скриптовом объекте (Cargo0..Cargo4);
// - связь — визуальный выстрел ShowEffect от корабля к грузу на шагах хода.
//
// Игра вызывает функции g_* через RunFunctionFromScript('TowBeam', '<имя без g_>', ...):
// инфошка TowBeam_Info (Lang) — g_Step, g_Target, g_Form; клавиша и кнопка (Main) — g_Key;
// загрузка сейва (Main, BV.OnLoad) — g_Loaded; бортовые настройки (dialogs.rsm) — g_Setting.
// Ловушка языка: вложенный if без скобок движок собирает иначе — скобки у всех тел.

export function onInit() {

  // ---------------------------------------------------------------- список грузов

  // Предмет i-го груза (0, если предмета больше нет).
  function TB_Item(int i) {
    result = IdToItem(int(GetParFromString(vList, ',', i, 0)));
  }

  // Номер предмета в списке грузов или -1.
  function TB_Index(dword obj) {
    int i;
    int id;
    id = Id(obj);
    result = -1;
    for (i = 0; i < vCount; i = i + 1) {
      if (int(GetParFromString(vList, ',', i, 0)) == id) {
        result = i;
        exit;
      }
    }
  }

  // Короткое имя предмета для сообщений.
  function TB_Name(dword obj) {
    if (ItemType(obj) > t_Hull && ItemType(obj) < t_Weapon1) {
      result = ShortName(obj);
    }
    else {
      result = Name(obj);
    }
  }

  function TB_ListAdd(dword obj) {
    if (vCount == 0) {
      vList = '' + Id(obj);
      vNames = TB_Name(obj);
    }
    else {
      vList = vList + ',' + Id(obj);
      vNames = vNames + '|' + TB_Name(obj);
    }
    vCount = vCount + 1;
  }

  function TB_ListRemove(int idx) {
    int i;
    str ids;
    str names;
    ids = '';
    names = '';
    for (i = 0; i < vCount; i = i + 1) {
      if (i != idx) {
        if (ids == '') {
          ids = GetParFromString(vList, ',', i, 0);
          names = GetParFromString(vNames, '|', i, 0);
        }
        else {
          ids = ids + ',' + GetParFromString(vList, ',', i, 0);
          names = names + '|' + GetParFromString(vNames, '|', i, 0);
        }
      }
    }
    vList = ids;
    vNames = names;
    vCount = vCount - 1;
  }

  function TB_ListClear() {
    vList = '';
    vNames = '';
    vCount = 0;
  }

  // Имена всех грузов через запятую.
  function TB_NamesText() {
    result = Format(vNames, '|', ', ', '');
  }

  // Общая масса грузов.
  function TB_Mass() {
    int i;
    int m;
    dword it;
    m = 0;
    for (i = 0; i < vCount; i = i + 1) {
      it = TB_Item(i);
      if (it) {
        m = m + ItemSize(it);
      }
    }
    result = m;
  }

  // ---------------------------------------------------------------- пределы и проверки

  function TB_Cfg(str key) {
    result = CT('TowBeam.Cfg.' + key);
  }

  // Дробное число из настроек. Слово float в этом языке — только объявление типа, функции такой нет
  // (в игре — Not link var :float); строка становится числом при присваивании переменной float.
  function TB_CfgF(str key) {
    float v;
    v = CT('TowBeam.Cfg.' + key);
    result = v;
  }

  // Предел общей массы: мощность захвата × множитель; 0 — без предела.
  function TB_Limit() {
    if (sMassMult <= 0) {
      result = 0;
      exit;
    }
    result = ShipHookPower(Player()) * sMassMult;
  }

  function TB_LimitText() {
    if (TB_Limit() > 0) {
      result = '' + TB_Limit();
    }
    else {
      result = CT('TowBeam.Info.NoLimit');
    }
  }

  // Оружейные слоты корпуса без нашего штрафа.
  function TB_TotalSlots() {
    result = ShipSlots(Player(), 1) + vSlots;
  }

  // Сколько грузов можно держать: в режиме «груз занимает слот» — по числу оружейных слотов.
  function TB_MaxCount() {
    int m;
    m = int(TB_Cfg('MaxCargo'));
    if (sWeapon == 1) {
      m = min(m, TB_TotalSlots());
    }
    result = m;
  }

  // Захват стоит, исправен и что-то поднимает.
  function TB_HookOk() {
    dword hook;
    result = 0;
    hook = ShipEqInSlot(Player(), t_CargoHook);
    if (!hook) {
      exit;
    }
    if (ItemIsBroken(hook)) {
      exit;
    }
    if (ShipHookPower(Player()) <= 0) {
      exit;
    }
    result = 1;
  }

  // Радиус захвата цели лучом.
  function TB_Range() {
    result = round(ShipHookRange(Player()) * TB_CfgF('RangeMult'));
  }

  // Почему предмет нельзя взять ('' — можно).
  function TB_Why(dword obj) {
    int lim;
    result = '';
    if (!TB_HookOk()) {
      result = 'NoHook';
      exit;
    }
    if (!ItemIn(obj, ShipStar(Player()))) {
      result = 'Invalid';
      exit;
    }
    if (ItemInScript(obj)) {
      result = 'Scripted';
      exit;
    }
    if (ItemType(obj) == t_ArtefactTranclucator) {
      result = 'Scripted';
      exit;
    }
    if (ItemDestroy(obj) > 0) {
      result = 'Invalid';
      exit;
    }
    if (vCount >= TB_MaxCount()) {
      result = 'TooMany';
      exit;
    }
    lim = TB_Limit();
    if (lim > 0) {
      if (TB_Mass() + ItemSize(obj) > lim) {
        result = 'TooHeavy';
        exit;
      }
    }
  }

  // ---------------------------------------------------------------- последствия буксировки

  // Защита от NPC: грузы — в именованных контейнерах Cargo0..Cargo4 (в режиме полной защиты).
  function TB_Relink() {
    int i;
    dword it;
    if (ItemExist(Cargo0)) {
      ReleaseItemFromScript(Cargo0);
    }
    if (ItemExist(Cargo1)) {
      ReleaseItemFromScript(Cargo1);
    }
    if (ItemExist(Cargo2)) {
      ReleaseItemFromScript(Cargo2);
    }
    if (ItemExist(Cargo3)) {
      ReleaseItemFromScript(Cargo3);
    }
    if (ItemExist(Cargo4)) {
      ReleaseItemFromScript(Cargo4);
    }
    if (sNpc != 0 || vOff) {
      exit;
    }
    for (i = 0; i < vCount; i = i + 1) {
      it = TB_Item(i);
      if (it) {
        if (i == 0) {
          LinkItemToScript(it, Cargo0);
        }
        else if (i == 1) {
          LinkItemToScript(it, Cargo1);
        }
        else if (i == 2) {
          LinkItemToScript(it, Cargo2);
        }
        else if (i == 3) {
          LinkItemToScript(it, Cargo3);
        }
        else if (i == 4) {
          LinkItemToScript(it, Cargo4);
        }
      }
    }
  }

  // Масса: груз добавляется к массе корабля так, будто лежит в трюме (формула движка
  // TShip.CalculateMass: вес корпуса − свободное место + собственная масса корпуса,
  // всё × (1 + бонус массы / 100)). Держим только свою долю бонуса — vMass.
  function TB_ApplyMass() {
    dword pl;
    dword hull;
    int mt;
    int want;
    int w;
    int other;
    float own;
    float raw;
    pl = Player();
    want = 0;
    mt = TB_Mass();
    if (mt > 0 && !vOff) {
      hull = ShipEqInSlot(pl, t_Hull);
      w = ItemSize(hull);
      own = (0.6 + 0.2 * (ItemLevel(hull) - 1) / 7.0) * w;
      raw = w - ShipFreeSpace(pl) + own;
      if (raw < 1) {
        raw = 1;
      }
      other = ShipSpecialBonuses(pl, bonMass, 'Total') - vMass;
      want = round(100.0 * mt * (1.0 + 0.01 * other) / raw);
    }
    if (want != vMass) {
      ShipSpecialBonuses(pl, bonMass, ShipSpecialBonuses(pl, bonMass) - vMass + want);
      vMass = want;
      ShipCalcParam(pl);
    }
  }

  // Прыжок: штраф к дальности, если груз летит с игроком; запрет прыжков, если так настроено.
  function TB_ApplyJump() {
    dword pl;
    int want;
    pl = Player();
    want = 0;
    if (sJump == 1 && vCount > 0 && !vOff) {
      want = round(1.0 * TB_Mass() / TB_CfgF('JumpMassPerParsec'));
    }
    if (want != vJump) {
      ShipSpecialBonuses(pl, bonJump, ShipSpecialBonuses(pl, bonJump) + vJump - want);
      vJump = want;
      ShipCalcParam(pl);
    }
    if (sJump == 2 && vCount > 0 && !vOff) {
      if (!vNoJump && !NoJump()) {
        NoJump(1);
        vNoJump = 1;
      }
    }
    else if (vNoJump) {
      NoJump(0);
      vNoJump = 0;
    }
  }

  // Режим «груз занимает слот»: закрываем по слоту на груз (движок оставляет минимум один),
  // пушки из закрытых слотов снимаем в трюм и запоминаем, при открытии слотов ставим обратно.
  function TB_ApplySlots() {
    dword pl;
    dword w;
    int want;
    int total;
    int open;
    int k;
    int i;
    int n;
    int id;
    int slot;
    str e;
    str keep;
    pl = Player();
    want = 0;
    total = TB_TotalSlots();
    if (sWeapon == 1 && vCount > 0 && !vOff) {
      want = min(vCount, total - 1);
      if (want < 0) {
        want = 0;
      }
    }
    if (want == vSlots) {
      exit;
    }
    open = total - want;
    // Пушки из закрывающихся слотов запоминаем и снимаем ДО смены числа слотов: ShipEqInSlot сам
    // вызывает RefreshAssignedItemSlots, и после смены движок снял бы их молча, без нашей записи.
    for (k = 5; k > open; k = k - 1) {
      w = ShipEqInSlot(pl, t_Weapon1, k);
      if (w) {
        ItemIsInUse(w, pl, 0);
        if (vTakenOff == '') {
          vTakenOff = '' + Id(w) + ':' + k;
        }
        else {
          vTakenOff = vTakenOff + ',' + Id(w) + ':' + k;
        }
      }
    }
    ShipSpecialBonuses(pl, bonSlotWeapon, ShipSpecialBonuses(pl, bonSlotWeapon) + vSlots - want);
    vSlots = want;
    keep = '';
    n = ParsCountFromString(vTakenOff, ',');
    for (i = 0; i < n; i = i + 1) {
      e = GetParFromString(vTakenOff, ',', i, 0);
      id = int(GetParFromString(e, ':', 0, 0));
      slot = int(GetParFromString(e, ':', 1, 0));
      if (slot <= open) {
        w = IdToItem(id);
        if (w) {
          if (ItemIn(w, pl) && !ItemIsInUse(w, pl) && !ShipEqInSlot(pl, t_Weapon1, slot)) {
            ItemIsInUse(w, pl, 1, slot);
          }
        }
      }
      else {
        if (keep == '') {
          keep = e;
        }
        else {
          keep = keep + ',' + e;
        }
      }
    }
    vTakenOff = keep;
    ShipCalcParam(pl);
  }

  // Нужна ли блокировка всех орудий.
  function TB_NeedBlock() {
    result = 0;
    if (vCount <= 0 || vOff) {
      exit;
    }
    if (sWeapon == 0) {
      result = 1;
      exit;
    }
    if (vCount >= TB_TotalSlots()) {
      result = 1;
    }
  }

  function TB_Unblock() {
    float s;
    s = ShipStatusEffect(Player(), 3);
    if (s > 0) {
      ShipStatusEffect(Player(), 3, 0.0 - s - 1.0);
    }
    vBlock = 0;
  }

  // Блокировка орудий: сила — вероятность пропуска выстрела, каждый пропуск тратит единицу,
  // эффект затухает к началу хода — поэтому подпитываем на каждом шаге.
  function TB_Block() {
    float s;
    float level;
    if (!TB_NeedBlock()) {
      if (vBlock) {
        TB_Unblock();
      }
      exit;
    }
    level = TB_CfgF('BlockLevel');
    s = ShipStatusEffect(Player(), 3);
    if (s < level) {
      ShipStatusEffect(Player(), 3, level * 2);
    }
    vBlock = 1;
  }

  function TB_ApplyAll() {
    TB_ApplyMass();
    TB_ApplyJump();
    TB_ApplySlots();
    TB_Block();
  }

  // Строка в карточке корабля (раздел состояний): что на тросе и чем это оборачивается.
  function TB_UpdateInfo() {
    dword pl;
    str w;
    pl = Player();
    if (ShipFindCustomShipInfoByType(pl, 'TowBeam_Info') < 0) {
      exit;
    }
    if (vCount <= 0) {
      ShipCustomShipInfoDescription(pl, 'TowBeam_Info', 'NoShow');
      ShipCustomShipInfoData(pl, 'TowBeam_Info', 1, 0);
      exit;
    }
    w = '';
    if (TB_NeedBlock()) {
      w = CT('TowBeam.Info.WeaponsOff');
    }
    else if (vSlots > 0) {
      w = Format(CT('TowBeam.Info.SlotsOff'), '#N#', '' + vSlots, '');
    }
    ShipCustomShipInfoDescription(pl, 'TowBeam_Info', Format(CT('TowBeam.Info.Text'), '#Items#', TB_NamesText(), '#Mass#', '' + TB_Mass(), '#Limit#', TB_LimitText(), '#Weapons#', w, ''));
    ShipCustomShipInfoData(pl, 'TowBeam_Info', 1, vCount);
  }

  // Пересчитать всё после смены списка грузов или настроек.
  function TB_Refresh() {
    TB_Relink();
    TB_ApplyAll();
    TB_UpdateInfo();
  }

  // ---------------------------------------------------------------- взять, отпустить, потерять

  function TB_Attach(dword obj) {
    dword pl;
    dword prev;
    pl = Player();
    if (vCount == 0) {
      vStar = ShipStar(pl);
      vDmgStart = HullDamage(pl);
    }
    prev = pl;
    if (vCount > 0) {
      prev = TB_Item(vCount - 1);
    }
    TB_ListAdd(obj);
    TB_Refresh();
    ShowEffect(TB_Cfg('BeamEffect'), int(TB_Cfg('BeamPalette')), obj, prev, 0, 0, 0, 0, 0, 0, 0);
    StarMapBlinkingMessage(Format(CT('TowBeam.Msg.Attached'), '#Items#', TB_Name(obj), '#Weight#', '' + ItemSize(obj), '#Mass#', '' + TB_Mass(), '#Limit#', TB_LimitText(), ''));
  }

  // Убрать i-й груз из списка; сам предмет остаётся там, где он есть.
  function TB_Drop(int idx, str why) {
    str nm;
    nm = GetParFromString(vNames, '|', idx, 0);
    TB_ListRemove(idx);
    TB_Refresh();
    if (vCount <= 0 && vBlock) {
      TB_Unblock();
    }
    if (why == 'ReleasedOne') {
      StarMapBlinkingMessage(Format(CT('TowBeam.Msg.ReleasedOne'), '#Items#', nm, ''));
    }
    else {
      Ether(8, '', Format(CT('TowBeam.Msg.' + why), '#Items#', nm));
    }
  }

  // Отпустить всё: грузы остаются в космосе обычными предметами.
  function TB_ReleaseAll(str why) {
    str names;
    names = TB_NamesText();
    TB_ListClear();
    TB_Refresh();
    TB_Unblock();
    if (why == 'ReleasedAll') {
      StarMapBlinkingMessage(Format(CT('TowBeam.Msg.ReleasedAll'), '#Items#', names, ''));
    }
    else {
      Ether(8, '', Format(CT('TowBeam.Msg.' + why), '#Items#', names, '#Star#', Name(vStar)));
    }
  }

  // Проверить, что грузы всё ещё в космосе этой системы.
  function TB_Validate() {
    int i;
    dword it;
    str why;
    for (i = vCount - 1; i >= 0; i = i - 1) {
      it = TB_Item(i);
      why = '';
      if (!it) {
        why = 'Lost';
      }
      else if (ItemIn(it, Player())) {
        why = 'PickedUp';
      }
      else if (!ItemIn(it, vStar)) {
        why = 'Taken';
      }
      if (why != '') {
        TB_Drop(i, why);
      }
    }
  }

  // ---------------------------------------------------------------- движение и луч

  // Тип выражения в этом языке задаёт левый операнд: 0 - cos(x) считается в целых (получится 0),
  // поэтому дробные выражения начинаются с дробного числа: 0.0 - …, 1.0 * …, 0.01 * ….
  // Шаг 1: путь игрока на ход уже построен — груз летит к точке за кормой в конце хода.
  function TB_Move(dword star) {
    dword pl;
    dword it;
    float ex;
    float ey;
    float ea;
    float rad;
    float dx;
    float dy;
    float dist;
    float tx;
    float ty;
    float ux;
    float uy;
    float len2;
    float t;
    float px;
    float py;
    float warn;
    int i;
    int cx;
    int cy;
    int danger;
    pl = Player();
    ex = GetShipPath(pl, 'EndCoordX');
    ey = GetShipPath(pl, 'EndCoordY');
    ea = GetShipPath(pl, 'EndAngle');
    if (ex == 0 && ey == 0) {
      ex = CoordX(pl);
      ey = CoordY(pl);
      ea = ShipAngle(pl);
    }
    rad = ea * pi / 180.0;
    dx = sin(rad);
    dy = 0.0 - cos(rad);
    warn = TB_CfgF('StarWarn');
    danger = 0;
    for (i = 0; i < vCount; i = i + 1) {
      it = TB_Item(i);
      if (it) {
        dist = TB_CfgF('Tether') + i * TB_CfgF('Spacing');
        tx = ex - dx * dist;
        ty = ey - dy * dist;
        cx = CoordX(it);
        cy = CoordY(it);
        // ближайшая к звезде точка отрезка пути груза: летящий предмет внутри опасного радиуса движок уничтожает
        ux = tx - cx;
        uy = ty - cy;
        len2 = ux * ux + uy * uy;
        t = 0;
        if (len2 > 0) {
          t = 0.0 - (ux * cx + uy * cy) / len2;
          if (t < 0) {
            t = 0;
          }
          if (t > 1) {
            t = 1;
          }
        }
        px = t * ux + cx;
        py = t * uy + cy;
        if (px * px + py * py < warn * warn) {
          danger = 1;
        }
        if (abs(ux) + abs(uy) > 3) {
          GetItemFromStar(star, it);
          DropItemInSystem(star, it, cx, cy, round(tx), round(ty));
        }
      }
    }
    if (danger) {
      StarMapBlinkingMessage(CT('TowBeam.Msg.StarDanger'));
    }
  }

  // Шаги 2..BeamLastStep: визуальный выстрел от корабля к первому грузу и дальше по цепочке.
  function TB_Beams() {
    dword prev;
    dword it;
    int i;
    str fx;
    int pal;
    fx = TB_Cfg('BeamEffect');
    pal = int(TB_Cfg('BeamPalette'));
    prev = Player();
    for (i = 0; i < vCount; i = i + 1) {
      it = TB_Item(i);
      if (it) {
        ShowEffect(fx, pal, it, prev, 0, 0, 0, 0, 0, 0, 0);
        prev = it;
      }
    }
  }

  // Игрок оказался в другой системе (прыжок, чёрная дыра, телепорт).
  function TB_StarChanged(dword star) {
    dword pl;
    dword it;
    float rad;
    float dist;
    int i;
    str names;
    if (sJump != 1) {
      TB_ReleaseAll('BreakJump');
      exit;
    }
    pl = Player();
    rad = ShipAngle(pl) * pi / 180.0;
    for (i = 0; i < vCount; i = i + 1) {
      it = TB_Item(i);
      if (it) {
        if (ItemIn(it, vStar)) {
          GetItemFromStar(vStar, it);
          dist = TB_CfgF('Tether') + i * TB_CfgF('Spacing');
          DropItemInSystem(star, it, round(CoordX(pl) - sin(rad) * dist), round(CoordY(pl) + cos(rad) * dist));
        }
      }
    }
    vStar = star;
    TB_Validate();
    if (vCount > 0) {
      names = TB_NamesText();
      TB_Refresh();
      Ether(2, '', Format(CT('TowBeam.Msg.CameAlong'), '#Items#', names));
    }
  }

  // ---------------------------------------------------------------- вход из игры

  // Код инфошки на каждом шаге хода (0..11).
  function g_Step(int step) {
    dword pl;
    dword star;
    if (vOff || vCount <= 0) {
      exit;
    }
    pl = Player();
    if (!ShipInNormalSpace(pl)) {
      exit;
    }
    star = ShipStar(pl);
    if (star != vStar) {
      TB_StarChanged(star);
      exit;
    }
    if (step <= 1) {
      if (step == 0 || vDmgStart < 0) {
        vDmgStart = HullDamage(pl);
      }
    }
    // Захват и помехи проверяем на каждом шаге: ЭМ-попадание посреди хода к следующему ходу
    // может затухнуть (движок снимает 0,1 × силу + 5 за ход).
    if (step <= 10) {
      if (!TB_HookOk()) {
        TB_ReleaseAll('BreakHook');
        exit;
      }
      if (ShipStatusEffect(pl, 2) > 0) {
        TB_ReleaseAll('BreakMagnetic');
        exit;
      }
    }
    if (step == 1) {
      TB_Validate();
      if (vCount <= 0) {
        exit;
      }
      TB_Move(star);
    }
    if (step <= 10) {
      TB_Block();
      if (step >= 1 && sDamage > 0 && vDmgStart >= 0) {
        if (HullDamage(pl) - vDmgStart >= sDamage) {
          TB_ReleaseAll('BreakDamage');
          exit;
        }
      }
    }
    if (step >= 2 && step <= int(TB_Cfg('BeamLastStep'))) {
      TB_Beams();
    }
    if (step == 11) {
      TB_Validate();
      TB_Refresh();
      vDmgStart = -1;
    }
  }

  // Наведение (t_OnCustomTargettingCheck: final = 0; t_OnCustomTargetting: final = 1).
  // Ответ: 1 — цель подходит, 0 — не подходит, -1 — тихая отмена (своё сообщение уже показано).
  function g_Target(dword obj, int final) {
    int idx;
    str why;
    result = 0;
    if (vOff || !obj) {
      exit;
    }
    if (ObjectType(obj) != 6) {
      exit;
    }
    idx = TB_Index(obj);
    if (idx >= 0) {
      result = 1;
      if (final) {
        TB_Drop(idx, 'ReleasedOne');
        result = -1;
      }
      exit;
    }
    why = TB_Why(obj);
    if (why != '') {
      if (final) {
        StarMapBlinkingMessage(Format(CT('TowBeam.Msg.' + why), '#Weight#', '' + ItemSize(obj), '#Mass#', '' + TB_Mass(), '#Limit#', TB_LimitText(), '#Max#', '' + TB_MaxCount(), ''));
        result = -1;
      }
      exit;
    }
    result = 1;
    if (final) {
      TB_Attach(obj);
      result = -1;
    }
  }

  // Отладка: ящик минералов сбоку от корабля, сразу на буксир, и приказ лететь вперёд.
  function TB_DebugSpawn() {
    dword pl;
    dword it;
    float rad;
    pl = Player();
    if (!ShipInNormalSpace(pl)) {
      exit;
    }
    rad = ShipAngle(pl) * pi / 180.0;
    it = CreateGoods(t_Minerals, 150);
    DropItemInSystem(ShipStar(pl), it, round(cos(rad) * 90.0 + CoordX(pl)), round(sin(rad) * 90.0 + CoordY(pl)));
    TB_Attach(it);
    OrderMove(pl, round(sin(rad) * 2500.0 + CoordX(pl)), round(CoordY(pl) - cos(rad) * 2500.0));
  }

  // Клавиша 0 и кнопка: mode 0 — наведение луча; mode 1 (Shift+0, правая кнопка) — отцепить всё.
  function g_Key(int mode) {
    dword pl;
    pl = Player();
    if (vOff) {
      StarMapBlinkingMessage(CT('TowBeam.Msg.Off'));
      exit;
    }
    if (mode == 2) {
      // Отладка (клавиша 9): только при TowBeam.Cfg.Debug=1 — ящик минералов рядом и сразу на буксир.
      if (int(TB_Cfg('Debug')) == 1) {
        TB_DebugSpawn();
      }
      exit;
    }
    if (mode == 1) {
      if (vCount > 0) {
        TB_ReleaseAll('ReleasedAll');
      }
      else {
        StarMapBlinkingMessage(CT('TowBeam.Msg.NothingTowed'));
      }
      exit;
    }
    if (!ShipInNormalSpace(pl)) {
      exit;
    }
    if (!TB_HookOk()) {
      StarMapBlinkingMessage(CT('TowBeam.Msg.NoHook'));
      exit;
    }
    StarMapCustomSelectionMode('TowBeam_Info', TB_Range(), 'FireFull', 'FireSmall', '', CT('TowBeam.Msg.OutOfRange'), CT('TowBeam.Msg.Invalid'), 110, 190, 255);
  }

  // Открытие формы: посадка на планету или станцию — грузы сразу на склад этого места.
  function g_Form() {
    dword pl;
    dword loc;
    dword it;
    str f;
    str ids;
    str names;
    int i;
    int n;
    if (vOff || vCount <= 0) {
      exit;
    }
    f = CurrentForm();
    if (f != 'Planet' && f != 'PlanetNO' && f != 'RuinsTalk') {
      exit;
    }
    if (PlayerBridge()) {
      exit;
    }
    pl = Player();
    loc = GetShipPlanet(pl);
    if (!loc) {
      loc = GetShipRuins(pl);
    }
    if (!loc) {
      exit;
    }
    ids = vList;
    names = TB_NamesText();
    n = vCount;
    TB_ListClear();
    TB_Relink();
    for (i = 0; i < n; i = i + 1) {
      it = IdToItem(int(GetParFromString(ids, ',', i, 0)));
      if (it) {
        if (ItemIn(it, vStar)) {
          GetItemFromStar(vStar, it);
          AddItemToStorage(loc, it);
        }
      }
    }
    TB_ApplyAll();
    TB_Unblock();
    TB_UpdateInfo();
    Ether(7, '', Format(CT('TowBeam.Msg.Stored'), '#Items#', names, '#Place#', Name(loc)));
  }

  // После загрузки сейва: инфошка на месте, грузы на месте, наши бонусы сходятся со списком.
  function g_Loaded() {
    dword pl;
    pl = Player();
    if (!vOff && ShipFindCustomShipInfoByType(pl, 'TowBeam_Info') < 0) {
      ShipAddCustomShipInfo(pl, 'TowBeam_Info', 'NoShow');
    }
    if (vCount > 0) {
      TB_Validate();
    }
    TB_Refresh();
  }

  // Бортовые настройки: переключить по кругу (1 оружие, 2 предел массы, 3 прыжок, 4 NPC, 5 урон, 6 выключить/включить).
  function g_Setting(int which) {
    dword pl;
    pl = Player();
    if (which == 1) {
      sWeapon = 1 - sWeapon;
    }
    else if (which == 2) {
      if (sMassMult == 5) {
        sMassMult = 10;
      }
      else if (sMassMult == 10) {
        sMassMult = 15;
      }
      else if (sMassMult == 15) {
        sMassMult = 20;
      }
      else if (sMassMult == 20) {
        sMassMult = 30;
      }
      else if (sMassMult == 30) {
        sMassMult = 0;
      }
      else {
        sMassMult = 5;
      }
    }
    else if (which == 3) {
      sJump = sJump + 1;
      if (sJump > 2) {
        sJump = 0;
      }
    }
    else if (which == 4) {
      sNpc = 1 - sNpc;
    }
    else if (which == 5) {
      if (sDamage == 10) {
        sDamage = 20;
      }
      else if (sDamage == 20) {
        sDamage = 30;
      }
      else if (sDamage == 30) {
        sDamage = 50;
      }
      else if (sDamage == 50) {
        sDamage = 0;
      }
      else {
        sDamage = 10;
      }
    }
    else if (which == 6) {
      if (vOff) {
        vOff = 0;
        if (ShipFindCustomShipInfoByType(pl, 'TowBeam_Info') < 0) {
          ShipAddCustomShipInfo(pl, 'TowBeam_Info', 'NoShow');
        }
      }
      else {
        if (vCount > 0) {
          TB_ReleaseAll('ReleasedAll');
        }
        vOff = 1;
        TB_Refresh();
        TB_Unblock();
        if (ShipFindCustomShipInfoByType(pl, 'TowBeam_Info') >= 0) {
          ShipDeleteCustomShipInfo(pl, 'TowBeam_Info');
        }
      }
      exit;
    }
    TB_Refresh();
  }

  // Сводка состояния одной строкой — для проверок в лаборатории sr-lab и для отладки через SFT.
  function g_State() {
    int i;
    dword it;
    dword pl;
    str s;
    pl = Player();
    s = 'count=' + vCount + ' list=' + vList + ' mass=' + TB_Mass() + ' limit=' + TB_Limit() + ' vMass=' + vMass + ' vJump=' + vJump + ' vSlots=' + vSlots + ' block=' + vBlock + ' noJump=' + vNoJump + ' off=' + vOff + ' star=' + int(vStar) + ' takenoff=' + vTakenOff + ' set=' + sWeapon + '/' + sMassMult + '/' + sJump + '/' + sNpc + '/' + sDamage;
    for (i = 0; i < vCount; i = i + 1) {
      it = TB_Item(i);
      if (it) {
        s = s + ' c' + i + '=' + (CoordX(it) - CoordX(pl)) + ',' + (CoordY(it) - CoordY(pl));
      }
    }
    result = s;
  }

  // ---------------------------------------------------------------- старт скрипта

  if (ShipFindCustomShipInfoByType(Player(), 'TowBeam_Info') < 0) {
    ShipAddCustomShipInfo(Player(), 'TowBeam_Info', 'NoShow');
  }
  if (!vHint) {
    Ether(6, 'TowBeamHint', CT('TowBeam.Msg.Hint'));
    vHint = 1;
  }
}

export function onGlobal() {
  GRun();
}

export function onTurn() {
  //;
}

// Бортовые настройки мостика ExpPilotBridge: страница 12. Без мостика страницы нет — работают значения по умолчанию.
export function onDialogBegin() {
  str v;
  if (PlayerBridge() == 12) {
    if (vOff) {
      AddDialogInject('dTowOff', '', 'snap~' + CT('TowBeam.Set.TurnOn'), 11);
      exit;
    }
    if (sWeapon == 0) {
      v = CT('TowBeam.Set.Weapon0');
    }
    else {
      v = CT('TowBeam.Set.Weapon1');
    }
    // Префикс snap~ — после щелчка список ответов остаётся на той же прокрутке
    // (TfRuinsTalk.RunInjectedDialogKeepingScroll), иначе он прыгает к началу.
    // Значение — без тега цвета (пустой последний аргумент Format): текст в теге список ответов
    // не показывает. Метка #V#, а не <0>: литерал '<0>' rsmc собирает в Format('<0>', "<0>", 0),
    // и замена не находит метку (проверено в окне и разбором .scr 10.10.2026).
    AddDialogInject('dTowWeapon', '', 'snap~' + Format(CT('TowBeam.Set.Weapon'), '#V#', v, ''), 11);
    if (sMassMult > 0) {
      v = Format(CT('TowBeam.Set.MassN'), '#N#', '' + sMassMult, '');
    }
    else {
      v = CT('TowBeam.Set.Mass0');
    }
    AddDialogInject('dTowMass', '', 'snap~' + Format(CT('TowBeam.Set.Mass'), '#V#', v, ''), 11);
    v = CT('TowBeam.Set.Jump' + sJump);
    AddDialogInject('dTowJump', '', 'snap~' + Format(CT('TowBeam.Set.Jump'), '#V#', v, ''), 11);
    v = CT('TowBeam.Set.Npc' + sNpc);
    AddDialogInject('dTowNpc', '', 'snap~' + Format(CT('TowBeam.Set.Npc'), '#V#', v, ''), 11);
    if (sDamage > 0) {
      v = Format(CT('TowBeam.Set.DamageN'), '#N#', '' + sDamage, '');
    }
    else {
      v = CT('TowBeam.Set.Damage0');
    }
    AddDialogInject('dTowDamage', '', 'snap~' + Format(CT('TowBeam.Set.Damage'), '#V#', v, ''), 11);
    AddDialogInject('dTowOff', '', 'snap~' + CT('TowBeam.Set.TurnOff'), 11);
  }
}
